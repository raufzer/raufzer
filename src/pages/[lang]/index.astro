  },
  {
    title: { key: "skills.devops.title", value: t("skills.devops.title") },
    category: { key: "skills.devops.category", value: t("skills.devops.category") },
    description: { key: "skills.devops.description", value: t("skills.devops.description") },
    experience_years: { key: "skills.devops.experience_years", value: t("skills.devops.experience_years") },
    experience_label: { key: "skills.devops.experience_label", value: t("skills.devops.experience_label") },
  },
];

---

<Layout
  locale={locale}
  title="Abd Raouf Zerkhef"
  description={t("description")}
  alternateLinks={alternate}
>
  <Header nav={nav} locales={["en", "fr"]} currentLocale={locale} />

  <main>
    <Hero {...heroProps} />
    <Timeline {...experienceData} />
    <Timeline {...educationData} />
    <LinkList {...articlesProps} />
    <LinkList {...projectsProps} />
    <Skills heading={{ key: "skills.heading", value: t("skills.heading") }} content={skills} />
  </main>

  <Footer {...footerContent} />
</Layout>
