const skills = [
  {
    title: { key: "skills.python.title", value: t("skills.python.title") },
    category: { key: "skills.python.category", value: t("skills.python.category") },
    description: { key: "skills.python.description", value: t("skills.python.description") },
    experience_years: { key: "skills.python.experience_years", value: t("skills.python.experience_years") },
    experience_label: { key: "skills.python.experience_label", value: t("skills.python.experience_label") },
  },
  {
    primary: true,
    title: { key: "skills.ai.title", value: t("skills.ai.title") },
    category: { key: "skills.ai.category", value: t("skills.ai.category") },
