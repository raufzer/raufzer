    experience_label: { key: "skills.go.experience_label", value: t("skills.go.experience_label") },
  },
  {
    title: { key: "skills.flutter.title", value: t("skills.flutter.title") },
    category: { key: "skills.flutter.category", value: t("skills.flutter.category") },
    description: { key: "skills.flutter.description", value: t("skills.flutter.description") },
    experience_years: { key: "skills.flutter.experience_years", value: t("skills.flutter.experience_years") },
    experience_label: { key: "skills.flutter.experience_label", value: t("skills.flutter.experience_label") },
  },
  {
    title: { key: "skills.databases.title", value: t("skills.databases.title") },
    category: { key: "skills.databases.category", value: t("skills.databases.category") },
    description: { key: "skills.databases.description", value: t("skills.databases.description") },
    experience_years: { key: "skills.databases.experience_years", value: t("skills.databases.experience_years") },
